"Rome.Override.DRT_BARBARIAN_BRIBE" = "Ktoś taki jak ty byłby dla nas cennym nabytkiem. Sam zdecyduj, ile twoje usługi są warte.";
"Rome.Override.DRT_BARBARIAN_GIFT" = "Przyjmijcie ten dar w duchu braterstwa wojowników! Obyśmy nigdy nie dobyli mieczy przeciw sobie!";
"Rome.Override.DRT_BARBARIAN_INFO" = "Gdy dzielimy się wiedzą, wszyscy stajemy się mądrzejsi. Podzielmy się więc tym, co wiemy o świecie!";
"Rome.Override.DRT_BARBARIAN_ACCEPT_GIFT" = "Dar jest błogosławieństwem dla tego, kto go składa. Dziękujemy.";
"Rome.Override.DRT_BARBARIAN_ACCEPT_BRIBE" = "Złoto zawsze pomaga uniknąć nieporozumień tym, którzy pragną żyć w przyjaźni. Wielkie dzięki.";
"Rome.Override.DRT_BARBARIAN_ACKNOWLEDGE_ACCEPTANCE" = "Wasza zgoda świadczy o sile charakteru i mądrości.";
"Rome.Override.DRT_BARBARIAN_ACKNOWLEDGE_REJECTION" = "Wasza odmowa jest nierozważna. Ktoś mniej wyrozumiały mógłby ją uznać za zniewagę.";
"Rome.Override.DRT_BARBARIAN_ACKNOWLEDGE_DECLARATION" = "Nie pozostawiliście nam wyboru.";
"Rome.Override.DRT_BARBARIAN_REJECT_NOT_INTERESTED" = "Szkoda nam teraz czasu na wymianę pustych słów z takimi jak wy.";
"Rome.Override.DRT_BARBARIAN_REJECT_TOO_MANY_COUNTERS" = "Zaszczyciliśmy was, wysłuchując waszych bredni. Nie padło tu ani jedno słowo warte uwagi. Koniec tego bełkotu.";
"Rome.Override.DRT_BARBARIAN_REJECT_BRIBE" = "Nie jesteśmy naiwni. Nasz honor i nasza przyjaźń to nie byle towar na targu. Nawet za wasze złoto ich nie kupicie.";
"Rome.Override.DRT_BARBARIAN_DECLINE_PROTECTORATE" = "Wolność jest cenna i nie oddaje się jej lekko. Chcecie mieć w nas sługi i niewolników. Piękne słowa tego nie ukryją.";
"Rome.Override.DRT_BARBARIAN_DECLINE_ALLIANCE" = "Nic dobrego nie wyszłoby z tego sojuszu. Tak powiedzieliśmy i zdania nie zmienimy.";
"Rome.Override.DRT_BARBARIAN_DECLINE_CEASEFIRE" = "Zakończyć walkę? Dobry żart! Nie widzimy powodu, by kończyć wojnę między naszymi ludami. Przecież niektórzy z was wciąż żyją!";
"Rome.Override.DRT_BARBARIAN_DECLINE_NULLIFY" = "Nie zgadzamy się. Nie widzimy żadnego powodu, by zrywać nasz sojusz.";
"Rome.Override.DRT_BARBARIAN_DECLINE_ACCESS" = "Wy widzicie potrzebę przemarszu waszych wojsk przez nasze ziemie, my jej nie dostrzegamy. Mamy dość rozumu, by wam odmówić.";
"Rome.Override.DRT_BARBARIAN_DECLINE_REGION" = "Tu są kurhany i groby naszych przodków. Przelewaliśmy krew za tę ziemię. Nie oddamy wam ani skrawka naszego dziedzictwa!";
"Rome.Override.DRT_BARBARIAN_DECLINE_ATTACK" = "Nie widzimy, co mielibyśmy zyskać, atakując ten lud. Z żalem odrzucamy wasze żądanie.";
"Rome.Override.DRT_BARBARIAN_DECLINE_THREAT" = "Wasze czcze groźby nas nie trwożą. Zaryzykujemy.";
"Rome.Override.DRT_BARBARIAN_DECLINE_GIFT" = "Nie wiemy, co skłoniło was do złożenia tego daru. Nie możemy go przyjąć.";
"Rome.Override.DRT_BARBARIAN_DECLINE_OFFER" = "Nie mamy wam nic do zaoferowania w zamian, więc musimy odmówić.";
"Rome.Override.DRT_BARBARIAN_DECLINE_DEMAND" = "Choćbyście złożyli własne wnętrzności na ołtarzach naszych najwyższych bogów, nie zechcemy słuchać takich żądań.";
"Rome.Override.DRT_BARBARIAN_DECLINE_YEARLY_PAYMENT" = "Nie oddamy naszych ziem za takie błyskotki.";
"Rome.Override.DRT_BARBARIAN_DECLINE_PAYMENT_TOO_HIGH" = "Wasza oferta jest hojna, bardzo hojna. Właśnie dlatego musimy ją odrzucić. Nie chcemy uchodzić za złodziei!";
"Rome.Override.DRT_BARBARIAN_DECLINE_PAYMENT_TOO_LOW" = "Chyba macie nas za głupców, którzy nie umieją liczyć. Nie możemy przyjąć tak marnych warunków.";
"Rome.Override.DRT_BARBARIAN_ACCEPT_PROPOSITION" = "Przyjmujemy waszą hojną ofertę złożoną w dobrej wierze.";
"Rome.Override.DRT_BARBARIAN_ACCEPT_COUNTER" = "Wasza odpowiedź jest do przyjęcia.";
"Rome.Override.DRT_BARBARIAN_ACCEPT_DECLARATION" = "Czasem nawet silny wojownik musi ugryźć się w język i przyjąć to, czego przyjąć nie sposób. Na razie godzimy się na waszą propozycję...";
"Rome.Override.DRT_BARBARIAN_COUNTER_OFFER" = "Oferujemy...";
"Rome.Override.DRT_BARBARIAN_COUNTER_DEMAND" = "Sugerujemy, co następuje...";
"Rome.Override.DRT_BARBARIAN_COUNTER_INFO" = "Mamy nadzieję, że wam się to przyda...";
"Rome.Override.DRT_BARBARIAN_COUNTER_PROPOSITION" = "Naradziliśmy się i sądzimy, że tak będzie lepiej...";
"Rome.Override.DRT_BARBARIAN_COUNTER_BRIBE" = "Jestem pewien, że naszą przyjaźń przypieczętowałaby odpowiednio hojna danina w złocie. A może lepiej powiedzieć „dar”...";
"Rome.Override.DRT_BARBARIAN_RECIPIENT_WELCOME_ALLIED" = "Witaj, przyjacielu! Jak możemy ci pomóc?";
"Rome.Override.DRT_BARBARIAN_RECIPIENT_WELCOME_NEUTRAL" = "Witaj! Co chcesz nam dziś zaoferować?";
"Rome.Override.DRT_BARBARIAN_RECIPIENT_WELCOME_AT_WAR" = "Streszczaj się. Mamy dziś lepsze zajęcia niż słuchanie twego żałosnego skomlenia!";
