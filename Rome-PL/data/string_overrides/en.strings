"Rome.InGame.DRT_HUN_AVOID_ERADICATION" = "Przychodzimy pod białą flagą. Dalszy rozlew krwi przyniesie nam obu straty i niewiele zmieni. Odłóżmy miecze i omówmy warunki.";
