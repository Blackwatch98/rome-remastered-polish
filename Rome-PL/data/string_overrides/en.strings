/* Dyplomacja */
"Rome.Override.DRT_ROMAN_PROTECTORATE" = "Pogódźcie się z tym, że wasza niezależność dobiegła końca, i stańcie się państwem wasalnym, któremu bezpieczeństwo gwarantują rzymskie wojska.";
"Rome.Override.DRT_ROMAN_ALLIANCE" = "Gdy zawrzemy sojusz, nasi wrogowie zadrżą ze strachu.";
"Rome.Override.DRT_ROMAN_CEASEFIRE" = "Czas położyć kres temu niepotrzebnemu rozlewowi krwi.";
"Rome.Override.DRT_ROMAN_NULLIFY_ALLIANCE" = "Czas zakończyć nasz sojusz. Niech każdy z nas podąży własną drogą ku wielkości!";
"Rome.Override.DRT_ROMAN_TRADE" = "Handel przyniósłby dostatek obu naszym ludom.";
"Rome.Override.DRT_ROMAN_ACCESS" = "Prawo przemarszu wojsk Rzymu przez wasze ziemie bardzo pomogłoby nam pokonać wrogów.";
"Rome.Override.DRT_ROMAN_ATTACK" = "Będziemy wam wdzięczni za pomoc w walce z naszymi wrogami.";
"Rome.Override.DRT_ROMAN_THREAT" = "Rzymski gniew można załagodzić, pod warunkiem, że okażesz wystarczający szacunek – i stać cię na zapłacenie odpowiedniej ceny...";
"Rome.Override.DRT_ROMAN_BRIBE" = "Ktoś taki jak ty byłby dla nas cennym nabytkiem. Sam zdecyduj, ile twoje usługi są warte.";
"Rome.Override.DRT_ROMAN_GIFT" = "Przyjmijcie ten dar na znak naszego podziwu dla waszej cnoty i odwagi.";
"Rome.Override.DRT_ROMAN_INFO" = "Jeśli podzielimy się wiedzą o świecie, wszyscy na tym skorzystamy.";
"Rome.Override.DRT_ROMAN_ACCEPT_GIFT" = "Miło nam, że doceniacie naszą wartość. Dziękujemy.";
"Rome.Override.DRT_ROMAN_ACCEPT_BRIBE" = "Złoto pomaga uniknąć nieporozumień, zanim jeszcze zrodzi się przyjaźń. Dziękujemy.";
"Rome.Override.DRT_ROMAN_ACKNOWLEDGE_ACCEPTANCE" = "Wasza zgoda jest równie uprzejma, co rozsądna.";
"Rome.Override.DRT_ROMAN_ACKNOWLEDGE_REJECTION" = "Odmówiliście uprzejmie, lecz trudno uznać tę decyzję za rozsądną.";
"Rome.Override.DRT_ROMAN_ACKNOWLEDGE_DECLARATION" = "Nie pozostawiliście nam wielkiego wyboru. Ściśle mówiąc, żadnego.";
"Rome.Override.DRT_ROMAN_REJECT_NOT_INTERESTED" = "W tej chwili szkoda oddechu na próżne słowa.";
"Rome.Override.DRT_ROMAN_REJECT_TOO_MANY_COUNTERS" = "Długo rozmawialiśmy, niewiele osiągnęliśmy i niczego nie ustaliliśmy. Czas zakończyć rokowania.";
"Rome.Override.DRT_ROMAN_REJECT_BRIBE" = "Nasz honor i nasza przyjaźń to nie towar na targu. Nawet wasze złoto ich nie kupi.";
"Rome.Override.DRT_ROMAN_DECLINE_PROTECTORATE" = "Wolność jest nam droga i nie oddamy jej tak łatwo. Nie zamierzamy wam służyć, choćbyście ujęli to w najpiękniejsze słowa.";
"Rome.Override.DRT_ROMAN_DECLINE_ALLIANCE" = "Sojusz nie leży teraz w naszym interesie.";
"Rome.Override.DRT_ROMAN_DECLINE_CEASEFIRE" = "Na razie nie widzimy powodu, by kończyć walkę między naszymi ludami.";
"Rome.Override.DRT_ROMAN_DECLINE_NULLIFY" = "Nie widzimy uzasadnionego powodu, by zrywać sojusz między naszymi ludami.";
"Rome.Override.DRT_ROMAN_DECLINE_ACCESS" = "Wy widzicie potrzebę przemarszu wojsk przez nasze ziemie, my jej nie dostrzegamy. Tym razem musimy odmówić.";
"Rome.Override.DRT_ROMAN_DECLINE_REGION" = "Nasi przodkowie poświęcili życie, by zdobyć tę ziemię. My przelaliśmy krew, by ją utrzymać. Nie oddamy jej potulnie komuś takiemu jak wy!";
"Rome.Override.DRT_ROMAN_DECLINE_ATTACK" = "Atak na ten lud nie leży w naszym interesie, więc z żalem odrzucamy waszą prośbę.";
"Rome.Override.DRT_ROMAN_DECLINE_THREAT" = "Wasze czcze groźby nas nie trwożą. Zaryzykujemy.";
"Rome.Override.DRT_ROMAN_DECLINE_GIFT" = "Nie wiemy, co skłoniło was do złożenia tego daru. Nie możemy go przyjąć.";
"Rome.Override.DRT_ROMAN_DECLINE_OFFER" = "Nie jesteśmy w stanie odwzajemnić takiej oferty. Musimy ją odrzucić.";
"Rome.Override.DRT_ROMAN_DECLINE_DEMAND" = "Choćbyście złożyli broń u naszych stóp i błagali nas na kolanach, nie ulegniemy waszym żądaniom.";
"Rome.Override.DRT_ROMAN_DECLINE_YEARLY_PAYMENT" = "Nawet za wasze złoto nie oddamy naszych ziem.";
"Rome.Override.DRT_ROMAN_DECLINE_PAYMENT_TOO_HIGH" = "Honor nie pozwala nam przyjąć tej propozycji. Wzięto by nas za złodziei!";
"Rome.Override.DRT_ROMAN_DECLINE_PAYMENT_TOO_LOW" = "Honor nie pozwala nam przyjąć waszej oferty. Możemy rozmawiać, lecz nie sprzedamy się za marne grosze.";
"Rome.Override.DRT_ROMAN_ACCEPT_PROPOSITION" = "Przyjmujemy waszą wielkoduszną propozycję złożoną w dobrej wierze.";
"Rome.Override.DRT_ROMAN_ACCEPT_COUNTER" = "Wasza odpowiedź na naszą propozycję jest do przyjęcia.";
"Rome.Override.DRT_ROMAN_ACCEPT_DECLARATION" = "Waszej propozycji brak słuszności, honoru i cnoty, lecz musimy ją przyjąć.";
"Rome.Override.DRT_ROMAN_COUNTER_OFFER" = "Proponujemy, co następuje...";
"Rome.Override.DRT_ROMAN_COUNTER_DEMAND" = "Sugerujemy, co następuje...";
"Rome.Override.DRT_ROMAN_COUNTER_INFO" = "Ufamy, że te informacje wam się przydadzą...";
"Rome.Override.DRT_ROMAN_COUNTER_PROPOSITION" = "Rozważyliśmy waszą propozycję. Sądzimy, że poniższe warunki lepiej odpowiadają naszym interesom...";
"Rome.Override.DRT_ROMAN_COUNTER_BRIBE" = "Jestem pewien, że stosowny dar w złocie zaskarbiłby wam naszą przychylność...";
"Rome.Override.DRT_ROMAN_RECIPIENT_WELCOME_ALLIED" = "Witaj, przyjacielu Rzymu! O czym chcesz pomówić?";
"Rome.Override.DRT_ROMAN_RECIPIENT_WELCOME_NEUTRAL" = "Ave! Co chcesz zaproponować?";
"Rome.Override.DRT_ROMAN_RECIPIENT_WELCOME_AT_WAR" = "Streszczaj się! W czasie wojny nie mamy czasu na uprzejmości wobec takich jak ty!";
"Rome.Override.DRT_ROMAN_FINISHED" = "Czas zakończyć rokowania. Niech Jowisz Najlepszy Największy sprawi, by nasze kolejne spotkanie było równie owocne!";
"Rome.Override.DRT_ROMAN_DISHONEST_REGION_OFFER" = "Hojnie oferujecie nam ziemię, lecz nie sądzimy, by długo była nasza, nim wkroczą na nią wasze wojska. Odrzucamy tę ofertę.";
"Rome.Override.DRT_ROMAN_DISHONEST_ACCESS_OFFER" = "Co dano, można szybko odebrać! Odrzucamy waszą ofertę prawa przemarszu. Moglibyście je cofnąć i odciąć nasze wojska.";
"Rome.Override.DRT_ROMAN_DISHONEST_ACCESS_DEMAND" = "Nie jesteśmy głupcami. Gdybyśmy przyznali wam prawo przemarszu, wasze wojska ruszyłyby po nasze ziemie, zamiast przeciw waszym wrogom!";
"Rome.Override.DRT_ROMAN_DISHONEST_ATTACK_OFFER" = "Nie życzymy sobie, byście atakowali naszych rywali. Wątpimy, by wasi żołnierze w ogóle zobaczyli pole bitwy. Jeszcze mniej wierzymy w wasze obietnice.";
"Rome.Override.DRT_ROMAN_DISHONEST_ATTACK_THREAT" = "Wasze słowa obiecują pokój, lecz wasze czyny nie zawsze świadczyły o pokojowych zamiarach. Odrzucamy ofertę. Nie wierzymy, że powstrzymacie się od ataku.";
"Rome.Override.DRT_ROMAN_DISHONEST_TRIBUTE_OFFER" = "Nie przyjmiemy waszego złota. Nie wierzymy, że kiedykolwiek ujrzymy pieniądze, które tak gładko obiecujecie.";
"Rome.Override.DRT_BARBARIAN_NULLIFY_ALLIANCE" = "Porozmawiajmy szczerze i bez ogródek. Odłóżmy na bok słowa o przyjaźni i sojuszu. Niech każdy pójdzie własną drogą.";
"Rome.Override.DRT_CARTHAGE_ACKNOWLEDGE_DECLARATION" = "Nie pozostawiliście nam innego wyboru, jak przyjąć waszą decyzję.";
