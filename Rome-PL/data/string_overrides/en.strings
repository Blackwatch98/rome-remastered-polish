"Rome.Override.DRT_BARBARIAN_PROTECTORATE" = "Pogódźcie się z tym, że czas waszej niezależności dobiegł końca. Pod naszą ochroną będziecie długo żyć i opływać w dostatki.";
"Rome.Override.DRT_BARBARIAN_ALLIANCE" = "Gdy zawrzemy sojusz, wszyscy nasi wrogowie zadrżą z przerażenia.";
"Rome.Override.DRT_BARBARIAN_CEASEFIRE" = "Czas położyć kres rozlewowi krwi.";
"Rome.Override.DRT_BARBARIAN_TRADE" = "Handel między naszymi ludami przyniósłby nam wszystkim wielkie bogactwo.";
"Rome.Override.DRT_BARBARIAN_ACCESS" = "Prawo pościgu za wrogami przez wasze ziemie bardzo by nam pomogło.";
"Rome.Override.DRT_BARBARIAN_ATTACK" = "Wasza pomoc w walce z naszymi wrogami wiele by dla nas znaczyła. Będziemy wam wdzięczni.";
