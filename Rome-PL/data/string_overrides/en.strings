"Rome.Override.DRT_GREEK_CEASEFIRE" = "Czas położyć kres rozlewowi krwi.";
"Rome.Override.DRT_GREEK_NULLIFY_ALLIANCE" = "Wszystko ma swój czas życia i śmierci. Czas naszego sojuszu dobiegł końca. Rozstańmy się z szacunkiem.";
"Rome.Override.DRT_GREEK_TRADE" = "Handel przyniósłby wielki dostatek obu naszym ludom.";
"Rome.Override.DRT_GREEK_ACCESS" = "Gdybyście pozwolili nam przejść przez wasze ziemie, by uderzyć na wrogów, byłby to dowód prawdziwej przyjaźni.";
"Rome.Override.DRT_GREEK_ATTACK" = "Będziemy wam wdzięczni za pomoc w walce z naszymi wrogami.";
"Rome.Override.DRT_GREEK_THREAT" = "Greckiego honoru nie kupicie. Greckie miecze mogą jednak pozostać w pochwach za odpowiednią cenę... bardzo wysoką cenę.";
"Rome.Override.DRT_GREEK_BRIBE" = "Ktoś taki jak ty byłby dla nas cennym nabytkiem. Sam zdecyduj, ile twoje usługi są warte.";
"Rome.Override.DRT_GREEK_GIFT" = "Greckie dary przynoszą zaszczyt tym, którzy je przyjmują. Przyjmijcie je w duchu braterstwa!";
"Rome.Override.DRT_GREEK_INFO" = "Gdy dzielimy się mądrością, staje się jej dwa razy więcej. Skorzystajmy wszyscy na wymianie wiedzy!";
"Rome.Override.DRT_GREEK_ACCEPT_GIFT" = "Dar zawsze jest mile widziany, gdy już ocenimy go i należycie oszacujemy jego wartość. Dziękujemy.";
"Rome.Override.DRT_GREEK_ACCEPT_BRIBE" = "Złoto najpewniej toruje drogę do przyjaźni. Wielkie dzięki.";
"Rome.Override.DRT_GREEK_ACKNOWLEDGE_ACCEPTANCE" = "Wasza zgoda świadczy o uprzejmości, mądrości i rozsądku.";
"Rome.Override.DRT_GREEK_ACKNOWLEDGE_REJECTION" = "Odmówiliście uprzejmie, ale wasza decyzja jest słabo przemyślana.";
"Rome.Override.DRT_GREEK_ACKNOWLEDGE_DECLARATION" = "Nie pozostawiliście nam wyboru.";
"Rome.Override.DRT_GREEK_REJECT_NOT_INTERESTED" = "Wasze słowa są równie puste jak wasze sofizmaty i udawana filozofia. Nie mamy ochoty słuchać dalej.";
"Rome.Override.DRT_GREEK_REJECT_TOO_MANY_COUNTERS" = "Dość tych niedorzeczności. Mówiliście bez końca, a jednak prawie nic nie powiedzieliście.";
"Rome.Override.DRT_GREEK_REJECT_BRIBE" = "Nasz honor i przyjaźń nie są na sprzedaż. Przybyliśmy tu na rokowania. Na zniewagi się nie godzimy.";
"Rome.Override.DRT_GREEK_DECLINE_PROTECTORATE" = "Wolność jest nam droga i nie oddamy jej łatwo. Nie zamierzamy zostać waszymi poddanymi i niewolnikami, choćbyście znaleźli dla tego tysiąc uzasadnień.";
"Rome.Override.DRT_GREEK_DECLINE_ALLIANCE" = "Sojusz nie przyniósłby nam teraz korzyści.";
"Rome.Override.DRT_GREEK_DECLINE_CEASEFIRE" = "Zakończyć wojnę? Może kiedyś. Na razie nie widzimy powodu, by przerywać walkę.";
"Rome.Override.DRT_GREEK_DECLINE_NULLIFY" = "Nie widzimy żadnego rozsądnego powodu, by teraz zrywać sojusz.";
"Rome.Override.DRT_GREEK_DECLINE_ACCESS" = "Waszym zdaniem przemarsz przez nasze ziemie ma sens. My nie widzimy takiej potrzeby. Z całym szacunkiem, musimy odmówić.";
"Rome.Override.DRT_GREEK_DECLINE_REGION" = "Krew naszych przodków zrosiła tę ziemię. Nasz lud uprawiał te pola. Nie oddamy wam potulnie ani skrawka naszej ziemi!";
"Rome.Override.DRT_GREEK_DECLINE_ATTACK" = "Atak na ten lud nie leży w naszym interesie, więc z żalem odrzucamy waszą prośbę.";
"Rome.Override.DRT_GREEK_DECLINE_THREAT" = "Wasze czcze groźby nas nie trwożą. Zaryzykujemy.";
"Rome.Override.DRT_GREEK_DECLINE_GIFT" = "Nie wiemy, co skłoniło was do złożenia tego daru. Nie możemy go przyjąć.";
"Rome.Override.DRT_GREEK_DECLINE_OFFER" = "Musimy odmówić. Nie mamy nic do zaoferowania w zamian.";
"Rome.Override.DRT_GREEK_DECLINE_DEMAND" = "Choćbyście powołali się na wyrocznie i znaki od bogów, nie ulegniemy waszym żądaniom.";
"Rome.Override.DRT_GREEK_DECLINE_YEARLY_PAYMENT" = "Nie oddamy ziemi nawet za złoto. Może właśnie za złoto tym bardziej jej nie oddamy.";
"Rome.Override.DRT_GREEK_DECLINE_PAYMENT_TOO_HIGH" = "Oferujecie za wiele. Sumienie nie pozwala nam tego przyjąć.";
"Rome.Override.DRT_GREEK_DECLINE_PAYMENT_TOO_LOW" = "Wasza oferta jest krzywdząca i nierozsądna. Nie możemy przystać na tak marne warunki.";
"Rome.Override.DRT_GREEK_ACCEPT_PROPOSITION" = "Przyjmujemy waszą ofertę. Jest hojna i uczciwa.";
"Rome.Override.DRT_GREEK_ACCEPT_COUNTER" = "Wasza odpowiedź jest jasna i rozsądna. Dziękujemy.";
"Rome.Override.DRT_GREEK_ACCEPT_DECLARATION" = "Wasza propozycja zawstydziłaby nawet helotę, lecz musimy ją przyjąć. Żadnemu z bogów za taką pomoc dziękować nie będziemy...";
"Rome.Override.DRT_GREEK_COUNTER_OFFER" = "Sugerujemy, co następuje...";
"Rome.Override.DRT_GREEK_COUNTER_DEMAND" = "Prosimy o następujące ustępstwa...";
"Rome.Override.DRT_GREEK_COUNTER_INFO" = "Ufamy, że te informacje wam się przydadzą...";
"Rome.Override.DRT_GREEK_COUNTER_PROPOSITION" = "Rozważyliśmy waszą propozycję i sądzimy, że poniższe warunki byłyby dla nas korzystne...";
"Rome.Override.DRT_GREEK_COUNTER_BRIBE" = "Kto chciałby dowieść prawdziwej przyjaźni, zawsze może złożyć stosowny dar w złocie...";
"Rome.Override.DRT_GREEK_RECIPIENT_WELCOME_ALLIED" = "Witaj, szlachetny sojuszniku! Jak możemy ci pomóc?";
"Rome.Override.DRT_GREEK_RECIPIENT_WELCOME_NEUTRAL" = "Witaj! Co chcesz zaproponować?";
"Rome.Override.DRT_GREEK_RECIPIENT_WELCOME_AT_WAR" = "Witaj, szlachetny przeciwniku! O czym chcesz pomówić, nim dosięgnie cię przedwczesny koniec?";
"Rome.Override.DRT_GREEK_FINISHED" = "Czas zakończyć rokowania. Oby następne spotkanie było równie owocne...";
"Rome.Override.DRT_GREEK_DISHONEST_REGION_OFFER" = "Wasza oferta ziemi brzmi szczerze, ale znając wasze dotychczasowe postępowanie, podejrzewamy, że już zbieracie wojsko, by ją sobie odebrać! Odrzucamy ofertę.";
"Rome.Override.DRT_GREEK_DISHONEST_ACCESS_OFFER" = "Choć dajecie nam zgodę, nie zamierzamy wkraczać na wasze ziemie. Wasze słowa wiele obiecują, ale czyny mówią co innego.";
"Rome.Override.DRT_GREEK_DISHONEST_ACCESS_DEMAND" = "Żądacie prawa przemarszu przez nasze ziemie. Tylko śliniący się głupiec by na to przystał. Zbyt często zdradzaliście przyjaciół, łamaliście obietnice i kłamaliście!";
"Rome.Override.DRT_GREEK_DISHONEST_ATTACK_OFFER" = "Nie możemy ufać, że dotrzymacie słowa. Już wcześniej nas okłamywaliście. Odrzucamy waszą ofertę ataku na naszych rywali.";
"Rome.Override.DRT_GREEK_DISHONEST_ATTACK_THREAT" = "Pięknie zapewniacie, że nas nie zaatakujecie. W ustach uczciwych ludzi brzmiałoby to wiarygodnie. W waszych brzmi pusto. Odrzucamy ofertę.";
"Rome.Override.DRT_GREEK_DISHONEST_TRIBUTE_OFFER" = "Złoto to piękny dar, a dar wart jest tyle, co ofiarodawca. Wasza danina byłaby więc bezwartościowa i godna pogardy. Odrzucamy ją.";

"Rome.Override.DRT_EGYPT_PROTECTORATE" = "Faraon, oby cieszył się zdrowiem i siłą, oznajmia: „Wszystkie wasze bazy są należą do nas!”. Czas, by wasze królestwo uznało łaskawe zwierzchnictwo faraona.";
"Rome.Override.DRT_EGYPT_ALLIANCE" = "Sojusz mógłby sprawić, że wrogowie faraona zadrżą ze strachu. Byłoby to pożądane.";
"Rome.Override.DRT_EGYPT_CEASEFIRE" = "Faraon uznał, że nadszedł czas zakończyć rozlew krwi, który kala nasze stosunki.";
"Rome.Override.DRT_EGYPT_NULLIFY_ALLIANCE" = "Faraon, oby cieszył się zdrowiem i siłą, uznał, że czas zakończyć sojusz z wami.";
"Rome.Override.DRT_EGYPT_TRADE" = "Faraon wie, że handel przysporzyłby dostatku jego sługom i dzieciom.";
"Rome.Override.DRT_EGYPT_ACCESS" = "Faraon woli zapytać o zgodę na przemarsz przez wasze ziemie, nim skorzysta ze swego boskiego prawa. Tak unikniemy nieporozumień, a wam będzie raźniej.";
"Rome.Override.DRT_EGYPT_ATTACK" = "Wielki faraon będzie wdzięczny za waszą skromną pomoc w walce z jego wrogami.";
"Rome.Override.DRT_EGYPT_THREAT" = "Niełatwo odwrócić potężny gniew faraona! Jego armie powstrzymają się od ataku tylko za odpowiednią cenę.";
"Rome.Override.DRT_EGYPT_BRIBE" = "Ktoś taki jak ty byłby dla nas cennym nabytkiem. Sam zdecyduj, ile twoje usługi są warte.";
"Rome.Override.DRT_EGYPT_GIFT" = "Faraon z radością obdarza nawet tak niegodnych śmiertelników jak wy drobiazgami na znak swej dobrej woli.";
"Rome.Override.DRT_EGYPT_INFO" = "Wiedza faraona nie zna granic. Jeśli jednak dołożymy do niej waszą skromną wiedzę o świecie, z pewnością wszyscy na tym skorzystamy.";
"Rome.Override.DRT_EGYPT_ACCEPT_GIFT" = "Dar jest błogosławieństwem dla tego, kto go składa. Niech wdzięczność faraona ogrzeje wasze dusze.";
"Rome.Override.DRT_EGYPT_ACCEPT_BRIBE" = "Złoto często pomaga zażegnać nieporozumienia między tymi, którzy pragną żyć w przyjaźni.";
"Rome.Override.DRT_EGYPT_ACKNOWLEDGE_ACCEPTANCE" = "Wasza zgoda jest równie uprzejma, co mądra.";
"Rome.Override.DRT_EGYPT_ACKNOWLEDGE_REJECTION" = "Odmówiliście nieuprzejmie i zapewne wielce urazicie naszego szlachetnego faraona.";
"Rome.Override.DRT_EGYPT_ACKNOWLEDGE_DECLARATION" = "Nie pozostawiliście faraonowi wyboru w tej sprawie.";
"Rome.Override.DRT_EGYPT_REJECT_NOT_INTERESTED" = "Wymiana pustych słów z takimi jak wy odrywa nas tylko od spraw państwa.";
"Rome.Override.DRT_EGYPT_REJECT_TOO_MANY_COUNTERS" = "Padło wiele słów, które rozwiał pustynny wiatr. Nie powiedziano niczego godnego uwagi faraona. Rokowania dobiegły końca.";
"Rome.Override.DRT_EGYPT_REJECT_BRIBE" = "Honoru i przyjaźni faraona nie kupicie, zwłaszcza za tak śmiesznie mało złota.";
"Rome.Override.DRT_EGYPT_DECLINE_PROTECTORATE" = "Władza jest faraonowi droga i nie odda jej lekko. Nie zamierza wam służyć, choćbyście ukryli to za najgładszymi słowami.";
"Rome.Override.DRT_EGYPT_DECLINE_ALLIANCE" = "Sojusz nie leży obecnie w interesie faraona.";
"Rome.Override.DRT_EGYPT_DECLINE_CEASEFIRE" = "Mądry i wojowniczy faraon nie widzi jeszcze powodu, by zaprzestać walki.";
"Rome.Override.DRT_EGYPT_DECLINE_NULLIFY" = "Mądry i wierny faraon nie widzi powodu, by okryć hańbą siebie i przyjaciół, wypierając się przyjaźni, która wciąż nas łączy.";
"Rome.Override.DRT_EGYPT_DECLINE_ACCESS" = "Wy widzicie powód, by prowadzić wojska przez ziemie faraona. On go nie widzi. Odmawia zgody.";
"Rome.Override.DRT_EGYPT_DECLINE_REGION" = "Tu jest wszystko, co dobre, i wszystko, na co pracowali nasi przodkowie. Sumienie nie pozwala faraonowi oddać ziemi, którą bogowie powierzyli jego pieczy.";
"Rome.Override.DRT_EGYPT_DECLINE_ATTACK" = "Jaką korzyść miałby odnieść z tego ataku łagodny faraon, który miłuje pokój? Wasza prośba jest niestosowna.";
"Rome.Override.DRT_EGYPT_DECLINE_THREAT" = "Wasze czcze groźby nas nie trwożą. Zaryzykujemy.";
"Rome.Override.DRT_EGYPT_DECLINE_GIFT" = "Nie wiemy, co skłoniło was do złożenia tego daru. Nie możemy go przyjąć.";
"Rome.Override.DRT_EGYPT_DECLINE_OFFER" = "Ta propozycja przekracza nasze możliwości. Z żalem musimy odmówić.";
"Rome.Override.DRT_EGYPT_DECLINE_DEMAND" = "Choćbyście oddali własne dzieci w niewolę ku większej chwale faraona, nie ulegnie on waszym żądaniom.";
"Rome.Override.DRT_EGYPT_DECLINE_YEARLY_PAYMENT" = "Za tak mało złota tym bardziej nie możemy oddać naszych ziem.";
"Rome.Override.DRT_EGYPT_DECLINE_PAYMENT_TOO_HIGH" = "Faraon, oby cieszył się zdrowiem i siłą, zastanawia się, czy wiecie, na czym polegają rokowania. Oferujecie tak zawstydzająco wiele, że nie możemy tego przyjąć.";
"Rome.Override.DRT_EGYPT_DECLINE_PAYMENT_TOO_LOW" = "Faraon, oby cieszył się długim życiem, mądrością i chwałą, uznałby waszą ofertę za zbyt marną, by ją przyjąć.";
"Rome.Override.DRT_EGYPT_ACCEPT_PROPOSITION" = "Wielkoduszny faraon spojrzał przychylnie na waszą starannie ułożoną propozycję.";
"Rome.Override.DRT_EGYPT_ACCEPT_COUNTER" = "Faraon może przyjąć waszą odpowiedź, choć przyszła z pewnym opóźnieniem...";
"Rome.Override.DRT_EGYPT_ACCEPT_DECLARATION" = "Faraon wzniesie się ponad zniewagi i przyjmie tę grubiańską, obraźliwą propozycję wyłącznie dla dobra swego ludu.";
"Rome.Override.DRT_EGYPT_COUNTER_OFFER" = "W imieniu faraona proponujemy, co następuje...";
"Rome.Override.DRT_EGYPT_COUNTER_DEMAND" = "W imieniu faraona proponujemy takie ustępstwa...";
"Rome.Override.DRT_EGYPT_COUNTER_INFO" = "W imieniu faraona przekazujemy wam te informacje w nadziei, że wam się przydadzą...";
"Rome.Override.DRT_EGYPT_COUNTER_PROPOSITION" = "Po namyśle potężny faraon uznał, że takie warunki lepiej służyłyby jego interesom...";
"Rome.Override.DRT_EGYPT_COUNTER_BRIBE" = "Odpowiednio hojna danina w złocie ułatwiłaby zdobycie przyjaźni faraona. Choć po namyśle lepiej chyba nazwać ją darem. Tak, darem...";
"Rome.Override.DRT_EGYPT_RECIPIENT_WELCOME_ALLIED" = "Witaj, przyjacielu wielkiego faraona! Jakiej pomocy potrzebujesz?";
"Rome.Override.DRT_EGYPT_RECIPIENT_WELCOME_NEUTRAL" = "Szlachetny i wspaniały faraon przesyła pozdrowienia. Jaką propozycję pragniesz złożyć przed nim z należną pokorą?";
"Rome.Override.DRT_EGYPT_RECIPIENT_WELCOME_AT_WAR" = "Streszczaj się. Słudzy faraona mają wiele spraw państwowych ważniejszych od rozmowy z kimś takim jak ty.";
"Rome.Override.DRT_EGYPT_FINISHED" = "Czas zakończyć rokowania. Oby kolejne spotkanie było równie owocne...";
"Rome.Override.DRT_EGYPT_DISHONEST_REGION_OFFER" = "Faraon odrzuca waszą ofertę nowych ziem. Skoro wy się czegoś pozbywacie, niewiele musi to być warte! Faraon sądzi zresztą, że z czasem niehonorowo odbierzecie swój dar!";
"Rome.Override.DRT_EGYPT_DISHONEST_ACCESS_OFFER" = "Faraon nie zamierza prowadzić armii przez wasze ziemie. Możecie przecież zmienić zdanie i zaatakować jego sługi, gdy znajdą się daleko od domu!";
"Rome.Override.DRT_EGYPT_DISHONEST_ACCESS_DEMAND" = "Faraon nie pozwoli, by wasze armie skalały jego ziemie. Odrzuca waszą prośbę. Kto wam uwierzy, że przejdziecie i nie zaatakujecie?";
"Rome.Override.DRT_EGYPT_DISHONEST_ATTACK_OFFER" = "Faraon nie potrzebuje pomocy takich jak wy w walce z rywalami i wrogami. Wiele obiecujecie, ale z doświadczenia wiemy, jak mało potraficie zdziałać!";
"Rome.Override.DRT_EGYPT_DISHONEST_ATTACK_THREAT" = "Faraon nie jest głupcem. Po co próbujecie go zwieść pozorami pokoju? Wszyscy wiedzą, że wasze słowo jest warte tyle co pustynny pył. Faraon odrzuca wasze czcze obietnice.";
"Rome.Override.DRT_EGYPT_DISHONEST_TRIBUTE_OFFER" = "Faraon nie potrzebuje waszego złota. W jego oczach danina od ludzi nic niewartych sama jest bezwartościowa. Odrzuca więc waszą ofertę.";

"Rome.Override.DRT_EASTERN_ALLIANCE" = "Nasz sojusz bez wątpienia zasiałby strach w sercach wszystkich naszych wrogów.";
"Rome.Override.DRT_EASTERN_CEASEFIRE" = "Czas położyć kres rozlewowi krwi. Zakończmy walkę.";
"Rome.Override.DRT_EASTERN_NULLIFY_ALLIANCE" = "Pora zastanowić się nad naszym sojuszem i rozwiązać go pokojowo. Tak czy inaczej, czas go zakończyć.";
"Rome.Override.DRT_EASTERN_TRADE" = "Handel między przyjaciółmi jest zawsze mile widziany, bo przynosi dostatek.";
"Rome.Override.DRT_EASTERN_ACCESS" = "Prosimy o prawo przemarszu naszych wojsk przez wasze ziemie, by uderzyć na wrogów z niespodziewanej strony.";
"Rome.Override.DRT_EASTERN_ATTACK" = "Będziemy wam wdzięczni za pomoc w walce z naszymi wrogami. Nasz lud będzie was za to szanował jeszcze bardziej.";
"Rome.Override.DRT_EASTERN_THREAT" = "Być może macie w skarbcu dość złota, by powstrzymać nasze armie. Zastanówcie się, ile warte są wasze życie i wolność...";
"Rome.Override.DRT_EASTERN_BRIBE" = "Ktoś taki jak ty byłby dla nas cennym nabytkiem. Sam zdecyduj, ile twoje usługi są warte.";
"Rome.Override.DRT_EASTERN_GIFT" = "Dar jest błogosławieństwem dla tego, kto go składa. W tym duchu przyjmijcie nasz skromny podarunek...";
"Rome.Override.DRT_EASTERN_INFO" = "Gdy dzielimy się wiedzą, wszyscy stajemy się mądrzejsi. Podzielmy się więc tym, co wiemy o świecie, a obie strony na tym skorzystają!";
"Rome.Override.DRT_EASTERN_ACCEPT_GIFT" = "Dar jest błogosławieństwem dla tego, kto go składa, choćby był najskromniejszy. Dziękujemy.";
"Rome.Override.DRT_EASTERN_ACCEPT_BRIBE" = "Złoto najskuteczniej łagodzi napięcia, które mogłyby zdusić przyjaźń w zarodku. Dziękujemy.";
"Rome.Override.DRT_EASTERN_ACKNOWLEDGE_ACCEPTANCE" = "Wasza zgoda świadczy o roztropności i uprzejmości.";
"Rome.Override.DRT_EASTERN_ACKNOWLEDGE_REJECTION" = "Odmówiliście uprzejmie, choć nierozważnie.";
"Rome.Override.DRT_EASTERN_ACKNOWLEDGE_DECLARATION" = "Nie pozostawiliście nam wyboru.";
"Rome.Override.DRT_EASTERN_REJECT_NOT_INTERESTED" = "Z tej wymiany pustych słów mamy tyle, co z szumu wiatru. Czy wy to nazywacie rokowaniami?";
"Rome.Override.DRT_EASTERN_REJECT_TOO_MANY_COUNTERS" = "Rozmawialiśmy bez końca i niczego nie ustaliliśmy. Na tym kończymy rokowania. Co za ulga mieć to już za sobą.";
"Rome.Override.DRT_EASTERN_REJECT_BRIBE" = "Honoru i przyjaźni nie kupi się za mieszek złota. Co najmniej dwa... a właściwie trzy lub cztery mieszki wypadałoby położyć na początek...";
"Rome.Override.DRT_EASTERN_DECLINE_PROTECTORATE" = "Nikomu nie oddamy naszej niezależności. Mielibyśmy zostać niewolnikami za kilka pięknych słów? Nic z tego!";
"Rome.Override.DRT_EASTERN_DECLINE_ALLIANCE" = "Sądzimy, że sojusz nie leżałby w naszym interesie.";
"Rome.Override.DRT_EASTERN_DECLINE_CEASEFIRE" = "Na razie nie widzimy powodu, by kończyć walkę. Może później, gdy poznacie wartość pokoju...";
"Rome.Override.DRT_EASTERN_DECLINE_NULLIFY" = "Nie widzimy powodu, by zrywać tak korzystne i zgodne stosunki. Nasz sojusz chroni nas przed zawistnymi rywalami!";
"Rome.Override.DRT_EASTERN_DECLINE_ACCESS" = "Wy widzicie powody, by prowadzić wojska w tę i z powrotem po naszych ziemiach. My ich nie widzimy. Musimy odmówić.";
"Rome.Override.DRT_EASTERN_DECLINE_REGION" = "W tej ziemi spoczywają nasi zmarli. Stoją na niej nasze miasta, a nasi rolnicy uprawiają jej pola. Nie widzimy powodu, by oddać choćby najmniejszą część tego, co do nas należy!";
"Rome.Override.DRT_EASTERN_DECLINE_ATTACK" = "Decyzji o ataku na ten lud nie możemy podjąć lekkomyślnie. Na razie musimy odmówić spełnienia waszej prośby.";
"Rome.Override.DRT_EASTERN_DECLINE_THREAT" = "Wasze czcze groźby nas nie trwożą. Zaryzykujemy.";
"Rome.Override.DRT_EASTERN_DECLINE_GIFT" = "Nie wiemy, co skłoniło was do złożenia tego daru. Nie możemy go przyjąć.";
"Rome.Override.DRT_EASTERN_DECLINE_OFFER" = "Nie jesteśmy w stanie odwzajemnić takiej oferty. Musimy ją odrzucić.";
"Rome.Override.DRT_EASTERN_DECLINE_DEMAND" = "Nie ulegniemy waszym żądaniom. Prawo zdobywcy nie ma nic wspólnego ze sprawiedliwością, a od tego właśnie by się zaczęło.";
"Rome.Override.DRT_EASTERN_DECLINE_YEARLY_PAYMENT" = "Nie oddamy naszych ziem nawet za złoto. Nawet za tyle złota.";
"Rome.Override.DRT_EASTERN_DECLINE_PAYMENT_TOO_HIGH" = "Wasza niemądra hojność nikogo nie zwiedzie! Co knujecie? Odrzucamy ofertę!";
"Rome.Override.DRT_EASTERN_DECLINE_PAYMENT_TOO_LOW" = "Wasze obraźliwe skąpstwo nie zwiodłoby nawet dziecka. Czemu nie złożycie rozsądnej oferty? Tę propozycję odrzucamy.";
"Rome.Override.DRT_EASTERN_ACCEPT_PROPOSITION" = "Przyjmujemy waszą ofertę. Oby obie strony skorzystały na tym porozumieniu.";
"Rome.Override.DRT_EASTERN_ACCEPT_COUNTER" = "Wasza odpowiedź jest do przyjęcia. Oby obie strony skorzystały na tym porozumieniu.";
"Rome.Override.DRT_EASTERN_ACCEPT_DECLARATION" = "Musimy przyjąć tę obraźliwą propozycję, bo nie mamy wyboru. Nie oczekujcie jednak uśmiechów ani świętowania.";
"Rome.Override.DRT_EASTERN_COUNTER_OFFER" = "Oferujemy, co następuje...";
"Rome.Override.DRT_EASTERN_COUNTER_DEMAND" = "Żądamy, co następuje...";
"Rome.Override.DRT_EASTERN_COUNTER_INFO" = "Ufamy, że te informacje wam się przydadzą...";
"Rome.Override.DRT_EASTERN_COUNTER_PROPOSITION" = "Rozważyliśmy waszą ostatnią ofertę i sądzimy, że takie warunki byłyby sprawiedliwsze...";
"Rome.Override.DRT_EASTERN_COUNTER_BRIBE" = "Złoto sprzyja przyjaźni, o ile ofiaruje się je w odpowiedniej ilości...";
"Rome.Override.DRT_EASTERN_RECIPIENT_WELCOME_ALLIED" = "Witaj, szlachetny i hojny sojuszniku! Jakiej pomocy potrzebujesz?";
"Rome.Override.DRT_EASTERN_RECIPIENT_WELCOME_NEUTRAL" = "Witaj, dostojny gościu! Co chcesz zaproponować?";
"Rome.Override.DRT_EASTERN_RECIPIENT_WELCOME_AT_WAR" = "Co? No, mów, czego chcesz? Mamy czas tylko na najkrótsze propozycje...";
"Rome.Override.DRT_EASTERN_FINISHED" = "Na tym kończymy rozmowy. Oby kolejne spotkanie przyniosło równie wiele korzyści...";
"Rome.Override.DRT_EASTERN_DISHONEST_REGION_OFFER" = "Wasza reputacja was wyprzedza! Odrzucamy ofertę objęcia tych ziem we władanie. Zapewne należałyby do nas tylko do chwili, gdy wkroczyłyby na nie wasze wojska!";
"Rome.Override.DRT_EASTERN_DISHONEST_ACCESS_OFFER" = "Nie zamierzamy wkraczać na wasze ziemie! Wasze czyny nieraz przeczyły waszym słowom. Tylko głupiec wkłada rękę lwu do paszczy!";
"Rome.Override.DRT_EASTERN_DISHONEST_ACCESS_DEMAND" = "Powiedzmy wprost. Gdybyśmy przyznali wam prawo przemarszu przez nasze ziemie, równie dobrze moglibyśmy zaprosić was do najazdu! Musimy odmówić.";
"Rome.Override.DRT_EASTERN_DISHONEST_ATTACK_OFFER" = "Cieszy nas oferta ataku na naszych rywali, lecz wątpimy w jej szczerość i w wasze zamiary. Nie damy się wciągnąć w wasze intrygi.";
"Rome.Override.DRT_EASTERN_DISHONEST_ATTACK_THREAT" = "Nie zwiodą nas wasze słowa. Odrzucamy wasze świeżo złożone obietnice pokoju i zgody. Wasze dotychczasowe czyny aż nadto świadczą o wojnie, krwi, hańbie i śmierci.";
"Rome.Override.DRT_EASTERN_DISHONEST_TRIBUTE_OFFER" = "Nie przyjmiemy waszego złota. Nie wierzymy w szczerość waszej daniny ani w to, że w ogóle trafiłaby do naszego skarbca!";

"Rome.Override.DRT_HUN_ACCEPT_BRIBE" = "Złoto zawsze ułatwia porozumienie tym, którzy pragną żyć w przyjaźni. Wielkie dzięki.";
"Rome.Override.DRT_HUN_ACCEPT_COUNTER" = "Wasza odpowiedź jest do przyjęcia.";
"Rome.Override.DRT_HUN_ACCEPT_DECLARATION" = "Czasem nawet silny wojownik musi ugryźć się w język i przyjąć to, czego przyjąć nie sposób. Na razie godzimy się na waszą propozycję...";
"Rome.Override.DRT_HUN_ACCEPT_GIFT" = "Dar świadczy o tym, kto go składa. Dziękujemy.";
"Rome.Override.DRT_HUN_ACCEPT_PROPOSITION" = "Przyjmujemy waszą hojną ofertę złożoną w dobrej wierze.";
"Rome.Override.DRT_HUN_ACCESS" = "Prawo pościgu za wrogami przez wasze ziemie bardzo by nam pomogło.";
"Rome.Override.DRT_HUN_ACKNOWLEDGE_ACCEPTANCE" = "Wasza zgoda świadczy o mądrości.";
"Rome.Override.DRT_HUN_ACKNOWLEDGE_DECLARATION" = "Nie pozostawiliście nam wyboru.";
"Rome.Override.DRT_HUN_ACKNOWLEDGE_REJECTION" = "Wasza odmowa jest nierozważna. Niektórzy mogliby ją uznać za zniewagę.";
"Rome.Override.DRT_HUN_ALLIANCE" = "Gdy zawrzemy sojusz, wszyscy nasi wrogowie zadrżą z przerażenia.";
"Rome.Override.DRT_HUN_ATTACK" = "Gdy pomożecie nam w walce z wrogami, zaskarbicie sobie naszą przychylność.";
"Rome.Override.DRT_HUN_BRIBE" = "Ktoś taki jak ty byłby dla nas cennym nabytkiem. Sam zdecyduj, ile twoje usługi są warte.";
"Rome.Override.DRT_HUN_CEASEFIRE" = "Czas położyć kres rozlewowi krwi.";
"Rome.Override.DRT_HUN_COUNTER_BRIBE" = "Odpowiednio hojna danina w złocie mogłaby przypieczętować naszą przyjaźń. A może lepiej powiedzieć „dar”...";
"Rome.Override.DRT_HUN_COUNTER_DEMAND" = "Sugerujemy, co następuje...";
"Rome.Override.DRT_HUN_COUNTER_INFO" = "Mamy nadzieję, że wam się to przyda...";
"Rome.Override.DRT_HUN_COUNTER_OFFER" = "Oferujemy...";
"Rome.Override.DRT_HUN_COUNTER_PROPOSITION" = "Przemyśleliśmy waszą propozycję i sądzimy, że tak będzie lepiej...";
"Rome.Override.DRT_HUN_DECLINE_ACCESS" = "Wy widzicie potrzebę wysłania wojowników przez nasze ziemie. My jej nie widzimy. Musimy odmówić, bo jeszcze wzięto by nas za głupców.";
"Rome.Override.DRT_HUN_DECLINE_ALLIANCE" = "Nic dobrego nie wyszłoby z tego sojuszu. Tak powiedzieliśmy i zdania nie zmienimy.";
"Rome.Override.DRT_HUN_DECLINE_ATTACK" = "Nie widzimy, co mielibyśmy zyskać, atakując ten lud. Musimy odrzucić wasze żądanie.";
"Rome.Override.DRT_HUN_DECLINE_CEASEFIRE" = "Zakończyć walkę? Dobry żart! Nie widzimy powodu, by przerywać walki. Przecież niektórzy z was wciąż żyją!";
"Rome.Override.DRT_HUN_DECLINE_DEMAND" = "Choćbyście złożyli własne wnętrzności na ołtarzach naszych najwyższych bogów, nie zechcemy słuchać takich żądań.";
"Rome.Override.DRT_HUN_DECLINE_GIFT" = "Nie wiemy, co skłoniło was do złożenia tego daru. Nie możemy go przyjąć.";
"Rome.Override.DRT_HUN_DECLINE_NULLIFY" = "Nie zgadzamy się. Nie widzimy żadnego powodu, by zrywać nasz sojusz.";
"Rome.Override.DRT_HUN_DECLINE_OFFER" = "Nie mamy wam nic do zaoferowania w zamian, więc musimy odmówić.";
"Rome.Override.DRT_HUN_DECLINE_PAYMENT_TOO_HIGH" = "Wasza oferta jest hojna, bardzo hojna. Właśnie dlatego musimy ją odrzucić. Pod stosem złota można ukryć nawet najostrzejszy miecz…";
"Rome.Override.DRT_HUN_DECLINE_PAYMENT_TOO_LOW" = "Chyba macie nas za głupców, którzy nie umieją liczyć. Nie możemy przyjąć tak marnych warunków.";
"Rome.Override.DRT_HUN_DECLINE_PROTECTORATE" = "Wolność jest cenna i nie oddaje się jej lekko. Nie musicie czynić z nas sług i niewolników. Wasze piękne słowa to tylko słowa rzucone na wiatr.";
"Rome.Override.DRT_HUN_DECLINE_REGION" = "Przelaliśmy krew za tę ziemię. Tu leżą nasi zmarli. Zapłaciliśmy za nią życiem naszych ludzi. Nie oddamy wam ani skrawka naszego dziedzictwa!";
"Rome.Override.DRT_HUN_DECLINE_THREAT" = "Wasze czcze groźby nas nie trwożą. Zaryzykujemy.";
"Rome.Override.DRT_HUN_DECLINE_YEARLY_PAYMENT" = "Nie oddamy naszych ziem za takie błyskotki.";
"Rome.Override.DRT_HUN_DISHONEST_ACCESS_DEMAND" = "Tylko naiwni głupcy pozwoliliby wam posłać wojska przez swoje ziemie. My mamy więcej rozumu. Nie przejdziecie!";
"Rome.Override.DRT_HUN_DISHONEST_ACCESS_OFFER" = "Wasze słowa są nic niewarte! Najpierw dacie nam prawo przejścia przez wasze ziemie, a zaraz potem wyprzecie się własnych słów. Może szukacie pretekstu do wojny…";
"Rome.Override.DRT_HUN_DISHONEST_ATTACK_OFFER" = "Waszemu słowu nie można ufać. Mówicie, że zaatakujecie naszych wrogów, ale tylko bezmyślny głupiec dałby temu wiarę...";
"Rome.Override.DRT_HUN_DISHONEST_ATTACK_THREAT" = "Miło byłoby usłyszeć takie słowa od uczciwych wojowników. Wy jednak zbyt często mówiliście jedno, a czyniliście drugie. Musimy odrzucić waszą obietnicę.";
"Rome.Override.DRT_HUN_DISHONEST_REGION_OFFER" = "Oferujecie nam ziemię, ale nie wierzymy, że długo by do nas należała! Nim wyźrebią się klacze, wasze wojska odbiorą nam ją siłą. Odrzucamy ofertę!";
"Rome.Override.DRT_HUN_DISHONEST_TRIBUTE_OFFER" = "Nie przyjmiemy waszego złota. Plamią je kłamstwa i udawana przyjaźń. To dar krętaczy dla głupców, a my mamy dość rozumu, by odmówić.";
"Rome.Override.DRT_HUN_FINISHED" = "Na tym kończymy rozmowę. Oby kolejne spotkanie było równie owocne...";
"Rome.Override.DRT_HUN_GIFT" = "Przyjmijcie ten dar w duchu braterstwa wojowników! Obyśmy nigdy nie dobyli mieczy przeciw sobie!";
"Rome.Override.DRT_HUN_INFO" = "Gdy dzielimy się wiedzą, wszyscy stajemy się mądrzejsi. Podzielmy się więc tym, co wiemy o świecie!";
"Rome.Override.DRT_HUN_NULLIFY_ALLIANCE" = "Porozmawiajmy szczerze i bez ogródek. Odłóżmy na bok słowa o przyjaźni i sojuszu. Niech każdy pójdzie własną drogą.";
"Rome.Override.DRT_HUN_PROTECTORATE" = "Pogódźcie się z tym, że czas waszej wolności dobiegł końca. Pod naszą ochroną będziecie długo żyć i opływać w dostatki.";
"Rome.Override.DRT_HUN_RECIPIENT_WELCOME_ALLIED" = "Witaj, przyjacielu! Jak możemy ci pomóc?";
"Rome.Override.DRT_HUN_RECIPIENT_WELCOME_AT_WAR" = "Streszczaj się. Mamy dziś lepsze zajęcia niż słuchanie twego żałosnego skomlenia!";
"Rome.Override.DRT_HUN_RECIPIENT_WELCOME_NEUTRAL" = "Witaj! Co chcesz nam dziś zaoferować?";
"Rome.Override.DRT_HUN_REJECT_BRIBE" = "Nie jesteśmy naiwni. Nasz honor i nasza przyjaźń to nie byle towar na targu. Nawet za wasze złoto ich nie kupicie.";
"Rome.Override.DRT_HUN_REJECT_NOT_INTERESTED" = "Szkoda nam teraz czasu na wymianę pustych słów z takimi jak wy.";
"Rome.Override.DRT_HUN_REJECT_TOO_MANY_COUNTERS" = "Zaszczyciliśmy was, wysłuchując waszych bredni. Nie padło tu ani jedno słowo warte uwagi. Koniec tego bełkotu.";
"Rome.Override.DRT_HUN_THREAT" = "Złoto zawsze może powstrzymać nasze miecze. Ile warte są dla was spokój i życie?";
"Rome.Override.DRT_HUN_TRADE" = "Handel między naszymi ludami przyniósłby nam wszystkim wielkie bogactwo.";

