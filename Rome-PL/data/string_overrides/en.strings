"Rome.Override.DRT_CARTHAGE_ACCEPT_DECLARATION" = "Wasza propozycja przynosi niewielki zysk, a jeszcze mniej powodów do radości. Mimo to musimy ją przyjąć.";
"Rome.Override.DRT_CARTHAGE_COUNTER_OFFER" = "Proponujemy, co następuje...";
"Rome.Override.DRT_CARTHAGE_COUNTER_DEMAND" = "Sugerujemy, co następuje...";
"Rome.Override.DRT_CARTHAGE_COUNTER_INFO" = "Ufamy, że te informacje wam się przydadzą...";
"Rome.Override.DRT_CARTHAGE_COUNTER_PROPOSITION" = "Rozważyliśmy waszą propozycję i sądzimy, że te warunki lepiej posłużą naszym interesom...";
"Rome.Override.DRT_CARTHAGE_COUNTER_BRIBE" = "Odpowiednio hojny dar w złocie mógłby przypieczętować naszą przyjaźń...";
"Rome.Override.DRT_CARTHAGE_RECIPIENT_WELCOME_ALLIED" = "Witaj, przyjacielu i sojuszniku! Jak możemy ci pomóc?";
"Rome.Override.DRT_CARTHAGE_RECIPIENT_WELCOME_NEUTRAL" = "Witaj! Co chcesz zaproponować?";
"Rome.Override.DRT_CARTHAGE_RECIPIENT_WELCOME_AT_WAR" = "Streszczaj się! Nasza cierpliwość ma granice, a na naszą życzliwość nie zawsze możesz liczyć!";
"Rome.Override.DRT_CARTHAGE_FINISHED" = "Na tym kończymy rokowania. Oby kolejne spotkanie było równie owocne...";
"Rome.Override.DRT_CARTHAGE_DISHONEST_REGION_OFFER" = "Nie możemy przyjąć od was ziemi. Ryzyko jest zbyt wielkie, a zysku żadnego. Jeśli przyjmiemy ten dar, wasi żołnierze zaraz odbiorą nam go siłą!";
"Rome.Override.DRT_CARTHAGE_DISHONEST_ACCESS_OFFER" = "Przemarsz wojsk przez wasze ziemie nie przyniósłby nam korzyści. Później i tak zmienilibyście zdanie. Odrzucamy tę propozycję.";
"Rome.Override.DRT_CARTHAGE_DISHONEST_ACCESS_DEMAND" = "Nie możemy przyznać wam prawa przemarszu przez nasze ziemie. Być może kierujecie się honorem, ale wasze dotychczasowe czyny przemawiają przeciw wam...";
"Rome.Override.DRT_CARTHAGE_DISHONEST_ATTACK_OFFER" = "Być może szczerze zamierzacie zaatakować naszych rywali, ale wolimy założyć inaczej. Odrzucamy ofertę. Zysku z niej żadnego, a ryzyko jest zbyt wielkie.";
"Rome.Override.DRT_CARTHAGE_DISHONEST_ATTACK_THREAT" = "Zbyt wiele razy obiecywaliście pokój, by potem rozstrzygać sprawy mieczem. Być może opłaciłoby się uwierzyć w wasze pokojowe zamiary, ale odrzucamy ofertę.";
"Rome.Override.DRT_CARTHAGE_DISHONEST_TRIBUTE_OFFER" = "Obiecujecie złoto, ale jego blask nie przesłoni nam mieczy w waszych dłoniach. Dla własnego bezpieczeństwa odrzucamy waszą ofertę daniny.";

"Rome.Override.DRT_GREEK_PROTECTORATE" = "Pogódźcie się z końcem waszej pozornej niezależności. Waszym przeznaczeniem jest zostać królestwem zależnym pod naszą ochroną.";
