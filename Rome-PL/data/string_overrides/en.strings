/* Menu Bitwy historyczne */
"Rome.InGame.UI_FERAL_HISTORICAL_NO_BATTLE_SELECTED" = "Wybierz bitwę z listy.";
"Rome.Override.ARAUSIO_DESCR" = "Pod koniec II wieku p.n.e. Rzym poszerzał swoje granice. W tym samym czasie wędrowały też inne ludy, w tym Cymbrowie i Teutoni, plemiona z północy i zachodu. Początkowo ich wędrówki omijały ziemie rzymskie, lecz coraz dotkliwiej brakowało im miejsca do osiedlenia się. Około 110 roku p.n.e. dotarli do Galii Zaalpejskiej, gdzie starcie z Rzymem stało się nieuniknione. W 105 r. p.n.e. konsul Gnejusz Maliusz Maksymus został wysłany na północ wraz ze swoją armią, aby zająć się tym problemem, jednak nie pomógł mu w tym brak współpracy ze strony prokonsula Kwintusa Serviliusa Caepiona.\n\n";
"Rome.Override.MONS_GRAUPIUS_DESCR" = "W 84 roku n.e. prowincja Brytania była już w znacznej mierze podbita, jednak mieszkańcy północnych gór wciąż stawiali opór Rzymianom. Namiestnik Brytanii Agrykola wyruszył na północ ze znacznymi siłami, aby przełamać opór i narzucić rzymską władzę na wyżynach. Brytowie postanowili bronić się na stokach Mons Graupius. Rzymianie zaatakowali, a bitwa przerodziła się w rzeź miejscowej ludności, jeśli wierzyć Tacytowi, jedynemu źródłu opisującemu to starcie.\n\n";
"Rome.Override.PHARSALUS_DESCR" = "Wyprawy w Galii dowiodły zdolności Juliusza Cezara i zjednały mu przychylność żołnierzy. Jego legiony miały stanąć przed najtrudniejszą próbą, gdy w 49 roku p.n.e. przekroczył Rubikon, formalną granicę swojej prowincji, wkroczył do Italii i otwarcie rzucił wyzwanie Senatowi oraz swemu największemu rywalowi, Pompejuszowi. Przewagą Cezara było doświadczenie legionistów, z których większość walczyła pod jego rozkazami w Galii. Ich lojalność zapewnił sobie, podwajając żołd.\n\n";
"Rome.Override.RAPHIA_DESCR" = "Ponad sto lat po śmierci Aleksandra Wielkiego jego następcy wciąż walczyli o panowanie nad ziemiami rozbitego imperium. Antioch III z dynastii Seleucydów zamierzał odzyskać Celesyrię, niedawno zajętą przez Egipt. Początkowo niewiele mógł zdziałać. Okazja nadarzyła się po wstąpieniu na tron egipski Ptolemeusza IV. Nowy władca nie cieszył się sympatią, więc niektórzy egipscy generałowie i namiestnicy przeszli na stronę Seleucydów. Zanosiło się na wojnę.\n\nWiosną 217 roku p.n.e. obie strony zakończyły przygotowania. Egipska dyplomacja nie mogła już dłużej odwlekać walk. Armie ruszyły naprzód i starły się pod niewielką Rafią. Morze osłaniało jedno skrzydło każdej z nich. Obaj królowie skupili tam najsilniejsze oddziały i stamtąd dowodzili bitwą...";
"Rome.Override.TELAMON_DESCR" = "Po zakończeniu pierwszej wojny punickiej Rzymianie mieli powody do zadowolenia. W północnej Italii doszło do niepokojów, ale sam widok wojska wystarczył, by stłumić opór. Jednak w 225 roku p.n.e. sojusz plemion galijskich i najemników z Galii Zaalpejskiej przedostał się do Etrurii przez niestrzeżoną przełęcz w Apeninach. Rzym wezwał na pomoc całą środkową i południową Italię, która szybko wystawiła siły obronne. Rzymianie wymanewrowali Galów i zepchnęli ich ku wybrzeżu Toskanii. W tym czasie druga armia wylądowała bez przeszkód w Pizie i odcięła im drogę odwrotu. Galowie znaleźli się w potrzasku.\n\nPo bitwie pod Telamonem Rzymianie postanowili zabezpieczyć północną Italię i pokonać Galów. Miało to niemal podwoić obszar pod bezpośrednią władzą Rzymu. Do 220 roku p.n.e. podporządkowała się niemal cała ludność galijska, a Kartagina straciła jedno z głównych źródeł najemników, co znacznie ją osłabiło. Wywalczony pokój nie trwał długo.";
"Rome.Override.TEUTOBURGERWALD_DESCR" = "W 9 roku n.e. granica świata rzymskiego biegła wzdłuż Renu, który stanowił naturalną fosę. Dalej na północy, jak twierdzili Rzymianie, barbarzyńcy czaili się w mrocznych lasach i knuli, jak zniszczyć wszystko, co cywilizowane.\n\nCesarz August wierzył jednak, że plemiona germańskie można przekonać do wygód cywilizowanego życia, i dążył do pełnego urządzenia prowincji w głębi Germanii. Szanse na powodzenie wydawały się nikłe. Być może dlatego mianował namiestnikiem Kwinktyliusza Warusa, sprawnego zarządcę, lecz kiepskiego żołnierza. Jako urzędnik miał pobierać podatki, przeprowadzać pobór i wprowadzać rzymskie prawo. Być może rzymska sprawność zdołałaby przekonać Germanów.\n\nPlemiona germańskie zapewne doceniały rzymskie wygody, ale nie chciały rzymskiej władzy ani związanych z nią podatków. Miały niewiele pieniędzy, bo handel wymienny ich nie wymagał. Wolni wojownicy uznawali pobór za niewolę, a prawo rzymskie uważali za barbarzyńskie. Po co więzić i chłostać ludzi, skoro krwawa zemsta pozwalała należycie rozstrzygnąć spór?\n\nWarus założył główny obóz nad Wezerą, prawdopodobnie w okolicach dzisiejszego Minden. Gdy zbliżała się zima, wyruszył z armią i obozową ludnością na południe, na leża zimowe. Na tę okazję czekali Germanie. Ich potajemny przywódca Arminiusz przebywał wcześniej w obozie Warusa. Kiedy Rzymianie ruszyli i znana była już ich trasa, Arminiusz zniknął. Wtedy wojownicy z germańskich lasów zaczęli atakować...";
