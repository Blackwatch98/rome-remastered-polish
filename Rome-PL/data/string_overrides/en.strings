"Rome.Override.UI_FACTION_GREEK_CITIES_DESCRIPTION" = "Grecy\nLiczne falangi hoplitów, w tym Spartan, i wsparcie oddziałów strzeleckich, lecz niewielki wybór jazdy";
"Rome.Override.UI_FACTION_NUMIDIA_DESCRIPTION" = "Numidyjczycy\nLekka piechota pustynna i dobra jazda, w tym wyspecjalizowane oddziały na wielbłądach";
"Rome.Override.UI_FACTION_SCYTHIA_DESCRIPTION" = "Scytowie\nZnakomici jeźdźcy i łucznicy, lecz niemal zupełny brak piechoty do walki wręcz";
"Rome.Override.UI_FACTION_SPAIN_DESCRIPTION" = "Hiszpanie\nDobre połączenie fanatycznych barbarzyńców i zorganizowanej piechoty ze wsparciem jazdy";
"Rome.Override.UI_FACTION_THRACE_DESCRIPTION" = "Trakowie\nDuży wybór falang hoplitów i barbarzyńskich oddziałów do walki wręcz, lecz niewiele jazdy";
"Rome.Override.UI_FACTION_SLAVES_DESCRIPTION" = "Niewolnicy i buntownicy\nGladiatorzy oraz tani, choć słabi, chłopi";

/* Opisy jednostek i okrętów nadpisywane przez grę */
"Rome.Override.roman_light_infantry_descr" = "Zdyscyplinowany\nDobra wytrzymałość\nŚwietnie się ukrywa w lasach\nMoże się ukrywać w wysokiej trawie\nMoże wykonywać podkopy\n\nLekka piechota pomocnicza osłania cięższe oddziały i rozbija szyki wroga gradem oszczepów. Ich oszczepy mają większy zasięg niż ciężkie pila legionistów o żelaznych trzonach. Harcownicy nie noszą pancerzy, więc trudno im długo wytrzymać w walce wręcz. W razie potrzeby potrafią jednak walczyć. Trenują niemal równie ciężko jak legioniści, więc niełatwo się męczą. W ich oddziałach panuje równie surowa dyscyplina.";
"Rome.Override.roman_city_militia_descr" = "Może wykonywać podkopy\n\nW straży miejskiej służą miejscowi robotnicy i chłopi. Szkolenie przygotowuje ich do obrony własnych domów i pilnowania porządku na ulicach. Wyszkoleni legioniści mają znacznie szersze zadania. Od milicji obywatelskiej oczekuje się przede wszystkim pilnowania spokoju, a czasem być może także gaszenia pożarów. Strażnicy mają skromne wyposażenie. Wystarczy, że ustawią się z włóczniami za tarczami i utrzymają pozycję podczas szarży wroga. Z reguły im się to udaje.";
"Rome.Override.roman_legionary_cohort_i_descr" = "Zdyscyplinowany\nDobra wytrzymałość\nMoże uformować żółwia\nMoże wykonywać podkopy\n\nRzymscy legioniści to wytrzymali zawodowi żołnierze z dobrym pancerzem i znakomitą bronią. Wyróżniają ich dyscyplina, posłuszeństwo i umiejętność dostosowania się do sytuacji. Podchodząc pod umocnienia, mogą uformować żółwia, czyli testudo, i osłaniać się zachodzącymi na siebie tarczami.\n\nLegionista nosi świetnie wykonaną kolczugę, zwaną lorica hamata. Do tego dochodzą metalowy hełm i duża zakrzywiona tarcza. Każdy legionista ma dwa ciężkie oszczepy, zwane pila, i krótki miecz do pchnięć, gladius. Za grotem pilum znajduje się trzon z miękkiego żelaza, który wygina się przy trafieniu. Takiego oszczepu nie można wyciągnąć i odrzucić. Wbity w tarczę utrudnia przeciwnikowi ruch, a wbity w ciało zwykle zabija. Po rzuceniu oszczepów żołnierze skracają dystans i walczą mieczami.\n\nLegioniści ci pojawili się po reformach Gajusza Mariusza. Zniósł on wymagania dotyczące majątku i wieku i przekształcił armię rzymską w zawodowe wojsko. Żołnierz otrzymywał wyposażenie i żołd, a po 25 latach służby dostawał ziemię, która zapewniała mu utrzymanie do końca życia.";
"Rome.Override.roman_legionary_first_cohort_i_descr" = "Orzeł legionowy dodaje otuchy pobliskim oddziałom\nZdyscyplinowany\nDobra wytrzymałość\nMoże uformować żółwia\nMoże wykonywać podkopy\n\nPierwsza kohorta składa się z dobrze uzbrojonych i opancerzonych piechurów. Niosą do boju orła legionowego, symbol rzymskiej potęgi, który dodaje otuchy pozostałym oddziałom. To wytrzymali zawodowi żołnierze, którzy wyróżniają się dyscypliną, posłuszeństwem i umiejętnością dostosowania się do sytuacji. Podchodząc pod umocnienia, mogą uformować żółwia, czyli testudo, i osłaniać się zachodzącymi na siebie tarczami.\n\nLegionista nosi świetnie wykonaną kolczugę, zwaną lorica hamata. Do tego dochodzą metalowy hełm i duża zakrzywiona tarcza. Każdy legionista ma dwa ciężkie oszczepy, zwane pila, i krótki miecz do pchnięć, gladius. Za grotem pilum znajduje się trzon z miękkiego żelaza, który wygina się przy trafieniu. Takiego oszczepu nie można wyciągnąć i odrzucić. Wbity w tarczę utrudnia przeciwnikowi ruch, a wbity w ciało zwykle zabija. Po rzuceniu oszczepów żołnierze skracają dystans i walczą mieczami.\n\nKohorty te powstały po reformach Gajusza Mariusza, który stworzył armię zawodową. Po 25 latach służby żołnierze otrzymywali ziemię na utrzymanie do końca życia. Do pierwszej kohorty trafiali z czasem najlepsi legioniści.";
"Rome.Override.roman_legionary_cohort_ii_descr" = "Dobra wytrzymałość\nMoże uformować żółwia\nMoże wykonywać podkopy\n\nRzymscy legioniści to wytrzymali zawodowi żołnierze z dobrym pancerzem i znakomitą bronią. Wyróżniają ich dyscyplina, posłuszeństwo i umiejętność dostosowania się do sytuacji. Podchodząc pod umocnienia, mogą uformować żółwia, czyli testudo, i osłaniać się zachodzącymi na siebie tarczami.\n\nLegionista nosi świetnie wykonany metalowy pancerz segmentowy. Do tego dochodzą metalowy hełm i duża zakrzywiona tarcza. Każdy legionista ma dwa ciężkie oszczepy, zwane pila, i krótki miecz do pchnięć, gladius. Za grotem pilum znajduje się trzon z miękkiego żelaza, który wygina się przy trafieniu. Takiego oszczepu nie można wyciągnąć i odrzucić. Wbity w tarczę utrudnia przeciwnikowi ruch, a wbity w ciało zwykle zabija. Po rzuceniu oszczepów żołnierze skracają dystans i walczą mieczami.\n\nPancerz segmentowy przyjęto, ponieważ był tańszy w produkcji i zapewniał lepszą ochronę niż wcześniejsza kolczuga.";
"Rome.Override.roman_legionary_first_cohort_ii_descr" = "Orzeł legionowy dodaje otuchy pobliskim oddziałom\nZdyscyplinowany\nDobra wytrzymałość\nMoże uformować żółwia\nMoże wykonywać podkopy\n\nPierwsza kohorta składa się z dobrze uzbrojonych i opancerzonych piechurów. Niosą do boju orła legionowego, symbol rzymskiej potęgi, który dodaje otuchy pozostałym oddziałom. To wytrzymali zawodowi żołnierze, którzy wyróżniają się dyscypliną, posłuszeństwem i umiejętnością dostosowania się do sytuacji. Podchodząc pod umocnienia, mogą uformować żółwia, czyli testudo, i osłaniać się zachodzącymi na siebie tarczami.\n\nLegionista nosi świetnie wykonany metalowy pancerz segmentowy. Do tego dochodzą metalowy hełm i duża zakrzywiona tarcza. Każdy legionista ma dwa ciężkie oszczepy, zwane pila, i krótki miecz do pchnięć, gladius. Za grotem pilum znajduje się trzon z miękkiego żelaza, który wygina się przy trafieniu. Takiego oszczepu nie można wyciągnąć i odrzucić. Wbity w tarczę utrudnia przeciwnikowi ruch, a wbity w ciało zwykle zabija. Po rzuceniu oszczepów żołnierze skracają dystans i walczą mieczami.\n\nPancerz segmentowy był nieco łatwiejszy i tańszy w produkcji niż kolczuga. Miało to znaczenie, gdy Rzym musiał wyposażyć tak wielu żołnierzy.";
"Rome.Override.roman_praetorian_cohort_i_descr" = "Elita\nZdyscyplinowany\nDobra wytrzymałość\nMoże uformować żółwia\nMoże wykonywać podkopy\n\nKohorta pretorianów składa się z doborowych legionistów, wybieranych ze względu na umiejętności i lojalność polityczną. Generał może polegać na tym oddziale. Szkolenie pretorianów jest wymagające i niezwykle staranne. To jedni z najlepszych, najtwardszych i najbardziej nieustępliwych żołnierzy Rzymu. I dobrze o tym wiedzą!\n\nNoszą taki sam rynsztunek jak legioniści, lecz lepszej jakości. Mają pancerze segmentowe, metalowe hełmy i duże zakrzywione tarcze. Rzucają ciężkimi pila, po czym nacierają z krótkimi mieczami, zwanymi gladii. Żelazny trzon pilum wygina się przy trafieniu, więc nie da się go wyciągnąć i odrzucić. Pretorianie mogą też uformować żółwia, by chronić się przed ostrzałem.\n\nPierwsi pretorianie uchodzili za najdzielniejszych z dzielnych. Strzegli praetorium, czyli namiotu legata w obozie. Z czasem chronili ważnych dowódców i zyskali własne formacje, przydatne w wojnie i polityce. August ustanowił gwardię pretoriańską jako osobistą ochronę i sposób wywierania nacisku w Rzymie. Za późniejszych cesarzy pretorianie zasłynęli z intryg i morderstw.";
"Rome.Override.roman_praetorian_cohort_urban_i_descr" = "Więcej niż elita!\nZdyscyplinowany\nDobra wytrzymałość\nMoże uformować żółwia\nMoże wykonywać podkopy\n\nKohortę miejską tworzą doborowi legioniści, wybrani ze względu na umiejętności i lojalność. Pełnią służbę garnizonową w najważniejszych miastach imperium, a w polu walczą jako ciężka piechota i biorą na siebie główny ciężar starcia.\n\nWymagające szkolenie daje Rzymowi świetnych, wytrzymałych i nieustępliwych żołnierzy. Ich przewaga tkwi w wyszkoleniu, bo noszą taki sam rynsztunek jak legioniści: pancerze segmentowe, metalowe hełmy i duże tarcze. Mają po dwa pila o żelaznych trzonach, które wyginają się po trafieniu i uniemożliwiają odrzucenie broni, oraz krótkie miecze do walki z bliska.\n\nAugust utworzył kohorty miejskie do utrzymywania porządku w Rzymie. Choć były mniej liczne od pretorianów, częściowo równoważyły ich wpływy w mieście. Płacono im lepiej i służyły w lepszych warunkach niż zwykłe legiony. Później powołano podobne kohorty w innych dużych miastach imperium, a ich prefekt często stawał się ważną postacią polityczną.";
"Rome.Override.roman_arcani_descr" = "Elita\nMoże się ukrywać w każdym terenie\nBardzo dobra wytrzymałość\nMoże wykonywać podkopy\n\nArkanowie stanowią tajemniczą część rzymskiej armii. Działają w małych grupach, umieją się maskować i zwodzić wroga. Przypominają tajne stowarzyszenie, którego nazwy nie wypada wymawiać na głos.\n\nStarannie wykonany pancerz dobrze ich chroni, a dzięki znakomitej kondycji nie spowalnia ich i nie męczy. Zakrywają twarze maskami. Oddziały zaskoczone przez tych krwiożerczych wojowników mogą rzucić się do ucieczki.";
"Rome.Override.roman_heavy_onager_descr" = "Ciężkie onagry to ogromne machiny miotające niszczycielskie głazy i pociski zapalające w szyki oraz umocnienia wroga. Potrzebują licznej obsługi i są podatne na ataki szybkich oddziałów. Najlepiej sprawdzają się podczas oblężeń, gdy ich ostrzał może z czasem skruszyć nawet najmocniejsze mury. Można nimi też wybijać luki w formacjach wroga. Są szczególnie groźne dla oddziałów stojących w zwartym szyku.\n\nNazwa onagra pochodzi od dzikiego osła, znanego z silnego kopnięcia i złego usposobienia. Podobnie zachowuje się ta machina! Napędza ją gruba wiązka skręconych zwierzęcych ścięgien, cenionych za wytrzymałość i sprężystość. Po zwolnieniu zaczepu ramię wyrzuca głaz lub naczynie z płonącą zawartością na wielką odległość. Siła strzału wprawia całą machinę w drżenie i powoduje silny odrzut. Sprawna obsługa wymaga wielu ludzi, bo już samo naciągnięcie mechanizmu kosztuje sporo wysiłku.";
"Rome.Override.roman_heavy_onager_descr_short" = "Ciężkie onagry to ogromne machiny miotające niszczycielskie głazy i pociski zapalające w szyki oraz umocnienia wroga. Potrzebują licznej obsługi i są podatne na ataki szybkich oddziałów.";
"Rome.Override.barb_peltast_gaul_descr" = "Świetnie się ukrywa w lasach\nMoże się ukrywać w wysokiej trawie\n\nHarcownicy to lekkozbrojne oddziały, które nękają przeciwnika, rozbijają jego szyki przed głównym starciem i osłaniają cięższe wojska. Dzięki swoim umiejętnościom dobrze nadają się też do zastawiania zasadzek.\n\nKażdy harcownik ma kilka oszczepów, krótki miecz i małą tarczę. Harcownicy rezygnują z pancerza, żeby zachować szybkość.\n\nDo oddziałów harcowników często trafiają młodsi wojownicy plemienia. Dopiero muszą się wykazać w boju i w walce wręcz mogą nie sprostać zaprawionemu przeciwnikowi.";
"Rome.Override.barb_peltast_german_descr" = "Świetnie się ukrywa w lasach\nMoże się ukrywać w wysokiej trawie\n\nHarcownicy to lekkozbrojne oddziały, które nękają przeciwnika, rozbijają jego szyki przed głównym starciem i osłaniają cięższe wojska. Dzięki swoim umiejętnościom dobrze nadają się też do zastawiania zasadzek.\n\nKażdy harcownik ma kilka oszczepów, krótki miecz i małą tarczę. Harcownicy rezygnują z pancerza, żeby zachować szybkość.\n\nDo oddziałów harcowników często trafiają młodsi wojownicy plemienia. Dopiero muszą się wykazać w boju i w walce wręcz mogą nie sprostać zaprawionemu przeciwnikowi.";
"Rome.Override.barb_archer_dacian_descr" = "Świetnie się ukrywa w lasach\n\nOddziały łuczników nękają wroga i rozbijają jego szyki, żeby inni wojownicy mogli wedrzeć się między przeciwników. Noszą lekką broń i wyposażenie, a przed wrogiem chroni ich głównie szybkość. Gdy dopadnie ich jazda na otwartym terenie, mogą się ratować wycofaniem w dogodniejszy teren albo za mur tarcz własnej piechoty.\n\nIch łuki mają krótki zasięg, ale każdy z łuczników nosi spory zapas strzał myśliwskich i bojowych. Pierwsze powodują obfite krwawienie, drugie służą do przebijania pancerza. Łucznicy dobierają strzały do celu.\n\nNajlepiej radzą sobie w lasach, gdzie mogą wykorzystać umiejętność podchodzenia zwierzyny zdobytą na polowaniach.";
"Rome.Override.barb_archer_dacian_descr_short" = "Oddziały łuczników nękają wroga i rozbijają jego szyki, żeby inni wojownicy mogli wedrzeć się między przeciwników.";
"Rome.Override.barb_archer_scythian_descr" = "Świetnie się ukrywa w lasach\n\nOddziały łuczników nękają wroga i rozbijają jego szyki, żeby inni wojownicy mogli wedrzeć się między przeciwników. Noszą lekką broń i wyposażenie, a przed wrogiem chroni ich głównie szybkość. Gdy dopadnie ich jazda na otwartym terenie, mogą się ratować wycofaniem w dogodniejszy teren albo za mur tarcz własnej piechoty.\n\nIch łuki mają krótki zasięg, ale każdy z łuczników nosi spory zapas strzał myśliwskich i bojowych. Pierwsze powodują obfite krwawienie, drugie służą do przebijania pancerza. Łucznicy dobierają strzały do celu.\n\nNajlepiej radzą sobie w lasach, gdzie mogą wykorzystać umiejętność podchodzenia zwierzyny zdobytą na polowaniach.";
"Rome.Override.barb_archer_scythian_descr_short" = "Oddziały łuczników nękają wroga i rozbijają jego szyki, żeby inni wojownicy mogli wedrzeć się między przeciwników.";
